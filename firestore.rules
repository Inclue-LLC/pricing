rules_version = '2';

// Anyone who opens the site can read and edit estimates and the shared exchange rate.
// Only these two collections are writable, and each document is size-limited.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{doc} {
      function allowed() {
        return collection in ['estimates', 'settings'];
      }
      allow read, delete: if allowed();
      allow create, update: if allowed() && request.resource.data.size() < 100;
    }
  }
}
